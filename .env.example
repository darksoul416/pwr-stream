# Database (SQLite for dev, Postgres for production)
DATABASE_URL=file:./db/custom.db

# Cloudflare Web Analytics — free, privacy-friendly analytics
# Get your beacon token at https://www.cloudflare.com/web-analytics/
NEXT_PUBLIC_CF_ANALYTICS=

# Microsoft Clarity — free session replay + heatmaps
# Get your project ID at https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_ID=

# Giscus comments — GitHub Discussions as comment system
# Get your config at https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

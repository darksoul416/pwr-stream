# Database (for Prisma — not used for auth, only for optional features)
DATABASE_URL=file:/tmp/mobiman.db

# Supabase — free auth + database (https://supabase.com)
# Create a project, then go to Settings > API to get these keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend — optional, for custom emails (Supabase handles password reset emails natively)
RESEND_API_KEY=

# Cloudflare Web Analytics — free, privacy-friendly
NEXT_PUBLIC_CF_ANALYTICS=

# Microsoft Clarity — free session replay + heatmaps
NEXT_PUBLIC_CLARITY_ID=
